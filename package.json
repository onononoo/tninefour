{
  "name": "tninefour",
  "version": "1.1.2",
  "description": "A simple text editor with automatic syntax highlighting.",
  "author": "kaiklund INC.",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File build.ps1"
  },
  "build": {
    "appId": "com.kaiklund.tninefour",
    "productName": "tninefour",
    "copyright": "Copyright © 2026 kaiklund INC.",
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "artifactName": "installer/${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "portable/${productName} Portable ${version}.${ext}"
    }
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.4.5": true
  }
}
